# Copy to .env at the repo root. Values below are safe local defaults for Docker Compose.

# ---- API ----
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000

# Primary database (docker compose service "db")
DATABASE_URL=postgres://hubday:hubday@localhost:5432/hubday

# Test database (docker compose service "db_test", ephemeral tmpfs)
TEST_DATABASE_URL=postgres://hubday:hubday@localhost:5433/hubday_test

# Auth: opaque dev tokens are issued by /auth/login for seeded users.
# This secret signs the stateless session token. Do not use in production.
AUTH_TOKEN_SECRET=dev-only-insecure-secret-change-me

# CORS: comma-separated list of allowed web origins.
WEB_ORIGIN=http://localhost:5173

# ---- Web ----
VITE_API_URL=http://localhost:3000
