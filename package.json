{
  "name": "hubday",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "up": "docker compose up --build",
    "up:d": "docker compose up --build -d",
    "down": "docker compose down",
    "db:up": "docker compose up -d db db_test",
    "db:down": "docker compose down",
    "db:wait": "docker compose exec -T db pg_isready -U hubday -d hubday",
    "migrate": "pnpm --filter @hubday/api migrate",
    "seed": "pnpm --filter @hubday/api seed",
    "dev": "pnpm --parallel --filter @hubday/api --filter @hubday/web dev",
    "dev:api": "pnpm --filter @hubday/api dev",
    "dev:web": "pnpm --filter @hubday/web dev",
    "build": "pnpm --filter @hubday/contracts build && pnpm --filter @hubday/api build && pnpm --filter @hubday/web build",
    "typecheck": "pnpm --filter @hubday/contracts typecheck && pnpm --filter @hubday/api typecheck && pnpm --filter @hubday/web typecheck",
    "test": "pnpm --filter @hubday/api test",
    "test:e2e": "pnpm --filter @hubday/web test:e2e"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ],
    "overrides": {
      "react-is": "18.3.1"
    }
  }
}
